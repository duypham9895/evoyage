{
  "name": "evoyage",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "ratchet:update": "RATCHET_UPDATE=1 npx vitest run src/lib/__tests__/design-token-ratchet.test.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:real": "MOCK_APIS=false npx playwright test",
    "seed": "npx tsx scripts/seed-vietnam-models.ts",
    "seed:stations": "npx tsx scripts/seed-osm-stations.ts",
    "seed:all": "npm run seed && npm run seed:stations",
    "db:push:local": "npx tsx scripts/db-push-local.ts",
    "db:generate": "npx prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --quiet --no-warn-ignored"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sparticuz/chromium": "^149.0.0",
    "@types/leaflet": "^1.9.22",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.8.2",
    "html-to-image": "^1.11.13",
    "impit": "^0.14.8",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.34.2",
    "nanoid": "^5.1.16",
    "next": "16.4.5",
    "openai": "^7.52.0",
    "playwright-core": "^1.58.2",
    "posthog-js": "^1.447.0",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@vercel/blob": {
      "undici": "^6.29.1"
    },
    "posthog-js": {
      "fflate": "^0.4.9"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.4"
  }
}
